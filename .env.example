# Copy to .env for local dev. Never commit the real file.
# Vite only exposes VITE_* variables to the browser. Everything below stays on the server.

# Neon connection string. Leave unset in local preview — the app uses embedded Postgres.
DATABASE_URL=

# Public site origin used for eSewa/Khalti return URLs. No trailing slash.
# Example: https://baato.parts
APP_ORIGIN=

# Seller block printed on invoices. PAN is 9 digits. Set these before going live.
SELLER_LEGAL_NAME=BAATO Parts
SELLER_ADDRESS=Kathmandu, Nepal
SELLER_PAN=
SELLER_PHONE=

# Nepal mobile that receives WhatsApp fitment and order messages.
# 98XXXXXXXX or 97798XXXXXXXX. Leave blank to hide the buttons.
WHATSAPP_E164=

# eSewa ePay v2. Both values are required or the method stays hidden.
# ESEWA_ENV=prod uses the live host. Anything else uses the UAT host.
# Override the URLs only if eSewa gives you a different endpoint.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_ENV=uat
# ESEWA_FORM_URL=
# ESEWA_STATUS_URL=

# Khalti ePayment secret (the live_secret_key from the merchant admin).
# Send it as Authorization: Key <secret>. KHALTI_ENV=prod uses khalti.com.
KHALTI_SECRET_KEY=
KHALTI_ENV=uat
# KHALTI_API_URL=

# Fonepay dynamic QR. All four are required or the method stays hidden.
# Amounts are sent in rupees (150 or 150.50), HMAC-SHA512 hex, lowercase.
FONEPAY_MERCHANT_CODE=
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_SECRET=
FONEPAY_ENV=uat
# FONEPAY_API_URL=
# Shared secret for POST /api/payments/fonepay (header x-baato-webhook-secret).
# Fonepay's QR API has no merchant webhook; this route re-checks their status API.
FONEPAY_WEBHOOK_SECRET=
